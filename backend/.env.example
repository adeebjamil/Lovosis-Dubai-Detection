PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dubai_detection?schema=public
JWT_ACCESS_SECRET=change-me-to-64-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
REFRESH_REMEMBER_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=
ADMIN_SEED_NAME=Super Admin
ADMIN_SEED_EMAIL=admin@gmail.com
ADMIN_SEED_PASSWORD=change-me
# Streaming (MediaMTX runs on the same machine, localhost only)
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889
MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
MAX_CAMERAS=32
